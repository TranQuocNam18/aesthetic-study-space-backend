{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AestheticStudySpace;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_USE_ENV_VAR_AT_LEAST_32_CHARS_LONG",
    "Issuer": "AestheticStudySpace",
    "Audience": "AestheticStudySpace.Client",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
